# Configurazione backend FastAPI
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=enoteca_molise

# OBBLIGATORIA in produzione. Genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320
UPLOAD_DIR=uploads

# Origini del frontend autorizzate (separate da virgola)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin iniziale: creato solo se nel DB non esiste alcun amministratore
ADMIN_EMAIL=admin@enotecamolise.it
ADMIN_PASSWORD=

# true = le cantine che si registrano sono subito pubbliche
AUTO_APPROVE_PRODUCERS=false

# true = inserisce dati di esempio se il DB e' vuoto (solo sviluppo)
SEED_SAMPLE_DATA=false

# Importazione vini da PDF con IA (Dashboard > Gestione Prodotti > Importa schede (AI)).
# Basta UNA delle due chiavi. Senza chiave si possono importare solo PDF testuali.
#   Gemini:  chiave gratuita/a consumo da https://aistudio.google.com/apikey
#   Claude:  chiave da https://console.anthropic.com
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# modelli di riserva se il principale e' sovraccarico (errore 503) o senza quota (429)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
