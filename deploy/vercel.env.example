# Variabili d'ambiente del FRONTEND su Vercel
# Vercel > progetto > Settings > Environment Variables
# Spunta "Production" e "Preview", poi rifai il deploy (servono anche durante la build).

# Indirizzo del backend su Cloud Run + /api/v1 (senza / finale)
NUXT_PUBLIC_API_BASE=https://<servizio>-<id>.<regione>.run.app/api/v1

# Indirizzo del backend su Cloud Run, senza /api/v1: serve per foto, loghi e PDF
NUXT_PUBLIC_MEDIA_BASE=https://<servizio>-<id>.<regione>.run.app
